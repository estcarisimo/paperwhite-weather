# Environment for `paperwhite serve` and the systemd unit (deploy/systemd/).
# Copy to .env (git-ignored) and edit. Every variable is optional; the value shown is the
# default. Command-line flags override these.

# Configuration file with your location, units, and display settings.
PAPERWHITE_CONFIG=config.yaml

# Weather provider; `paperwhite providers` lists the names.
PAPERWHITE_PROVIDER=mock

# Interface to listen on. 0.0.0.0 means every interface, which a LAN service needs.
PAPERWHITE_HOST=0.0.0.0

# TCP port. Pick another if 8765 is taken (`ss -ltn | grep 8765`).
PAPERWHITE_PORT=8765
