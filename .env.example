# Environment for `paperwhite serve` and the systemd unit (deploy/systemd/).
# Copy to .env (git-ignored) and edit. Every variable is optional; the value shown is the
# built-in default. Command-line flags override these. The systemd unit loads .env; a
# manual `paperwhite serve` does not, so export the variables yourself in that case.

# Configuration file with your location, units, and display settings, relative to the
# working directory unless absolute. The systemd unit passes the absolute path.
PAPERWHITE_CONFIG=config.yaml

# Weather provider; `paperwhite providers` lists the names.
PAPERWHITE_PROVIDER=mock

# Interface to listen on. 0.0.0.0 means every interface, which a LAN service needs.
PAPERWHITE_HOST=0.0.0.0

# TCP port. Pick another if 8765 is taken (`ss -ltn | grep 8765`).
PAPERWHITE_PORT=8765

# Directory that keeps the skin chosen at runtime (from /skins or POST /skin) across
# restarts. Unset by default: the choice is forgotten on restart. The systemd unit sets it
# to its own state directory by itself (%S/paperwhite-weather); leave it commented there.
#PAPERWHITE_STATE_DIR=/var/tmp/paperwhite-weather
