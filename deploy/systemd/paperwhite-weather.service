# User-level systemd unit for the dashboard service on the Raspberry Pi.
#
# Install: `deploy/install.sh` does all of the below. By hand (as the user that owns the
# checkout; lingering must be enabled so the service starts at boot without a login:
# `loginctl show-user $USER -p Linger` must say `yes`, otherwise
# `sudo loginctl enable-linger $USER`):
#
#   mkdir -p ~/.config/systemd/user
#   sed "s|%REPO%|$PWD|g" deploy/systemd/paperwhite-weather.service \
#       > ~/.config/systemd/user/paperwhite-weather.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now paperwhite-weather.service
#   systemctl --user status paperwhite-weather.service
#   journalctl --user -u paperwhite-weather.service -f
#
# Settings are environment variables so the unit itself never needs editing:
# PAPERWHITE_CONFIG (default %REPO%/config.yaml, git-ignored; copy config.example.yaml),
# PAPERWHITE_PROVIDER (default mock), PAPERWHITE_HOST (default 0.0.0.0), PAPERWHITE_PORT
# (default 8765), PAPERWHITE_STATE_DIR (the skin chosen from /skins survives restarts;
# the unit points it at its StateDirectory, %S/paperwhite-weather, which for a user
# manager on systemd 252 is ~/.config/paperwhite-weather).
# Override any of them with `systemctl --user edit paperwhite-weather.service`
# or in %REPO%/.env (git-ignored; start from .env.example).

[Unit]
Description=Paperwhite Weather dashboard service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%REPO%
Environment=PAPERWHITE_CONFIG=%REPO%/config.yaml
Environment=PAPERWHITE_PROVIDER=mock
Environment=PAPERWHITE_STATE_DIR=%S/paperwhite-weather
EnvironmentFile=-%REPO%/.env
ExecStart=%REPO%/.venv/bin/paperwhite serve
Restart=on-failure
RestartSec=10
# Hardening that allows reading the checkout and writing only the state directory
# (StateDirectory= creates it and keeps it writable under ProtectHome=read-only).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%REPO%
StateDirectory=paperwhite-weather

[Install]
WantedBy=default.target
